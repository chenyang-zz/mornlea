# 编译产物
/bin/
*.exe
*.test
*.out

# go build ./packages/client/cmd/mornlea 的本地产物
/mornlea

# make visual-check / visual-update 默认输出目录（实拍图与差异图，仅调试用）
/build/

# 依赖缓存
/vendor/
/packages/engine/target/

# 编辑器
.DS_Store
.idea/
.vscode/

# 仓库内隔离工作区
/.worktrees/
# Claude Code 在仓库内开辟的 worktree（同属隔离工作区，不入库）
/.claude/worktrees/

# GitNexus 本机索引
/.gitnexus/

# ZCode 本机会话产物（计划文件等运行态）
/.zcode/

# 本机 Claude Code 权限配置（可能包含宽泛的 shell 授权）
/.claude/settings.local.json

# 运行时产生的世界存档
/saves/
/worlds/

# 性能剖析产物
*.pprof
cpu.prof
mem.prof

# SDD 工作区（子代理驱动开发的账本与评审包）
/.superpowers/
# gfxspike 的 `go build` 产物：根路径覆盖仓库根发起的构建，
# 包内路径覆盖在 packages/tools/gfxspike 目录下发起的构建
/gfxspike
/packages/tools/gfxspike/gfxspike
/midscene_run/

# 设备确认通道（scripts/agents/confirm）的 Node 工具链产物
**/node_modules/

# Python bytecode caches written by the locked Godot Python checks
__pycache__/
# 菜单 WebView 前端的 node_modules（dist 不忽略、提交入库）
packages/engine/crates/mornlea_client/frontend/node_modules/
# 菜单 WebView 前端视觉基线 harness 的构建产物（visual-check/visual-update
# 用，绝不写 dist/）
packages/engine/crates/mornlea_client/frontend/visual-dist/
scripts/agents/.npm-cache/
/packages/tools/agent-board/web/dist/

/packages/engine/crates/mornlea_client/frontend/visual/item-catalog.generated.json
# 伙伴 Agent 本机运行配置（由根 config.example.yaml 复制，不入库）
/config.yaml

# Archive new model videos and complete ZIP packages in the file library.
/assets/models/mornlea/**/*.[mM][pP]4
/assets/models/mornlea/**/*.[mM][oO][vV]
/assets/models/mornlea/**/*.[wW][eE][bB][mM]
/assets/models/mornlea/**/*.[mM][kK][vV]
/assets/models/mornlea/**/*.[aA][vV][iI]
/assets/models/mornlea/**/*.[zZ][iI][pP]
