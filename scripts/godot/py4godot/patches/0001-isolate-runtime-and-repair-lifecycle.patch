+static bool replace_python_search_path() {
+    const std::vector<std::filesystem::path> entries = {
+        python_home / "lib" / "python314.zip",
+        python_home / "lib" / "python3.14",
+        python_home / "lib" / "python3.14" / "lib-dynload",
+        python_home / "lib" / "python3.14" / "site-packages",
+    };
+    PyObject *path = PyList_New(0);
+    if (path == nullptr) {
+        PyErr_Clear();
+        report_error("Py4Godot hardening could not allocate the isolated import path");
+        return false;
+    }
+    for (const std::filesystem::path &entry : entries) {
+        PyObject *value = PyUnicode_DecodeFSDefault(entry.c_str());
+        if (value == nullptr || PyList_Append(path, value) != 0) {
+            Py_XDECREF(value);
+            Py_DECREF(path);
+            PyErr_Clear();
+            report_error("Py4Godot hardening could not set the isolated import path");
+            return false;
+        }
+        Py_DECREF(value);
+    }
+    const int result = PySys_SetObject("path", path);
+    Py_DECREF(path);
+    if (result != 0) {
+        PyErr_Clear();
+        report_error("Py4Godot hardening could not replace sys.path");
+        return false;
+    }
+    return true;
+}

