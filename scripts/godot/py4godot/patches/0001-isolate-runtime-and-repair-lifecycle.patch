+static void release_upstream_refcounted_singletons() {
+    auto loader = reinterpret_cast<void **>(dlsym(upstream_handle, "py_resource_format_loader"));
+    auto saver = reinterpret_cast<void **>(dlsym(upstream_handle, "py_resource_format_saver"));
+    if (loader == nullptr || saver == nullptr) {
+        report_error("Py4Godot hardening could not resolve upstream lifecycle objects");
+        return;
+    }
+    if (*loader != nullptr) {
+        auto *wrapper = reinterpret_cast<godot::Wrapper *>(*loader);
+        object_destroy(wrapper->godot_owner);
+        *loader = nullptr;
+    }
+    if (*saver != nullptr) {
+        auto *wrapper = reinterpret_cast<godot::Wrapper *>(*saver);
+        object_destroy(wrapper->godot_owner);
+        *saver = nullptr;
+    }
+}

