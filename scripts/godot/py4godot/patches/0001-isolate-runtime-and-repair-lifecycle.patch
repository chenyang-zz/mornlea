+static void initialize_hardened(void *userdata, GDExtensionInitializationLevel level) {
+    (void)userdata;
+    if (upstream_initialization.initialize != nullptr) {
+        initializing_upstream_scene = level == GDEXTENSION_INITIALIZATION_SCENE;
+        upstream_initialization.initialize(upstream_initialization.userdata, level);
+        initializing_upstream_scene = false;
+    }
+    if (level != GDEXTENSION_INITIALIZATION_SCENE || !python_initialized) {
+        return;
+    }
+    const PyGILState_STATE gil = PyGILState_Ensure();
+    replace_python_search_path();
+    PyGILState_Release(gil);
+}

